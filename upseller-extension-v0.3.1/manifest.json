{
  "manifest_version": 3,
  "name": "Upseller Bridge",
  "version": "0.3.1",
  "key": "",
  "description": "Preenche formulários do Upseller a partir do ZEM Calculator com IA (OpenAI ChatGPT)",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["https://app.upseller.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.upseller.com/pt/products/shopee/create*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://zemcalculator.vercel.app/*",
      "https://calculadora-preco-eight.vercel.app/*"
    ]
  }
}